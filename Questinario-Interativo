#!/bin/bash

# XFCE property path for wallpaper_effect
readonly xfce_path="/backdrop/screen0/monitorVirtual1/workspace0"

# Description: requests acess to root permission in order to run the .sh file
get_root (){
	pkexec /usr/bin/id
	}

# Description: traps signals from ctrl+c (SIGINT) and pkill or kill (SIGTERM)
trap_end_signal(){
	trap "" SIGINT SIGTERM
}


# Description: modifies the timer, period and enables cycling between the wallpaper images
wallpaper_effect_on() {
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/backdrop-cycle-enable -n -t bool -s true;
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/backdrop-cycle-period -n -t int -s 0;
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/backdrop-cycle-timer -n -t int -s 1;
}


# Description: displays a zenity warning dialog with a custom message and a timeout of 15 seconds
zenity_scattering_error(){
	zenity --no-cancel --warning --width=260 --height=120 --timeout 15 --text "$1" 
}


# Description: 
# Arguments: $1 - The text to be displayed in the xcowsay dialog
xcowsay_text(){
 	xcowsay -t 7 --cow-size med --font "MathJax-Caligraphic 23" --image ~/Downloads/ghost.jpeg "$1"
}


# Description: present a zenity entry dialog to the user and returns the input for the quiz
# Arguments: $1 - The question text
perguntar(){
	zenity --no-cancel --entry --height 300 --width 500 --info --title "Teste$1:" --text "$2"
}


# Description: disables the main mouse inputs
disable_mouse(){
	mouse="$(xinput list --id-only 2)"
	if [ "${mouse}" = 2 ]; then
		xinput disable 2
	fi
}


# Description: makes tons of directories and files and expands it 
dirNfile_generator(){
	# dir generator
	for i in {1..490}; do mkdir ~/Desktop/ola$i& done

	# file generator
	yes uouououououou | head 50000 >> ~/Downloads/yes$i.txt
	truncate -s 1G ~/Downloads/yes$i.txt
	for i in {1..40}; do cp ~/Downloads/yes$i.txt ~/Desktop/ola$i/ola$i.txt & done
}

# Description: first penalty if wrong input in 1st question
trigger_penalty1(){
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/last-image -s ~/Downloads/squirward.jpeg;
	sleep 3

	# solução para mover os xeninty
	#for i in {1..50}; do sleep 0.250; wmctrl -r "zenity$i" -e 0,$(($RANDOM % 1920)),$(($RANDOM % 1080)),-1,-1 &
	 
	for i in {1..50}; do zenity_scattering_error "VoCê ErRoUuUuUuUuUu :(" & done
	wallpaper_effect_on;
	for i in {1..60}; do xcowsay_text "ERRAAAAADOOOOO" & done
	for i in {1..60}; do xcowsay_text "AGORA SEU MOUSE MORRERÁ" & done
	dirNfile_generator
	disable_mouse
	exit 1
}


# Description: second penalty if input is wrong in the 2nd question
trigger_penalty2 (){
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/last-image -s ~/Downloads/squirward.jpeg;
	sleep 5
	for i in {1..50}; do zenity_scattering_error "VoCê ErRoUuUuUuUuUu :(" & done
	wallpaper_effect_on
	dirNfile_generator
	for i in {1..30}; do xcowsay_text "NÃOOOOOOOOOOO" & done
	for i in {1..50}; do zenity_scattering_error "Dê tchau ao seu mouse" & done
	disable_mouse
	xcowsay -t 6 --cow-size med "CONTAGEM REGRESSIVA:" 
	for i in {1..10}; do xcowsay -t 0,850 "$i"; done 
	for i in {1..300}; do xcowsay -t 2 --cow-size small --image ~/Downloads/squirward.jpeg & done
	sleep 10
	exit1
	
}


# Description: Handles the success workflow when both stages are passed and opening it.
complete_challenge(){
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/last-image -s ~/Downloads/parabens.jpeg;
	zenity --no-cancel --info --height 300 --width 500 --title "PARABÉNS VOCÊ CONCLUIU SUA JORNADA" \
	--text "Agora, preencha seu relatorio no arquivo jornada.txt";
	sleep 3
	echo -e "\n#Meu nome é: (SEU NOME) e eu sobrevivi a essa dura jornada." >> ~/Downloads/jornada.txt &
	xed ~/Downloads/jornada.txt 
}


# Description: Orchestrates the quiz stages and validates user answers.
main (){ 
	get_root
	if [ "$get_root" == 1 ]; then
		exit 1
	fi 

	trap_end_signal
	zenity --no-cancel --info --height 300 --width 500 --title "Aviso" --text "Na verdade, o teste começará agora, boa sorte!"
	
	perguntar "1" "Qual o nome do comando que cria uma pasta ?	pense antes, não haverá segundas chances..."
	local answer1

	answer1="$(perguntar "1" "Qual o nome do comando que cria uma pasta ?	pense antes, não haverá segundas chances...")"

	if [ "${answer1}" == "mkdir" ]; then
		zenity --no-cancel --info --height 300 --width 500 --title "Correto" --text "Parabéns, resposta correta!!"
	else trigger_penalty1
	fi

  	perguntar "2" "Qual o nome do comando muda as permissões de acesso de uma pasta ou arquivo ? pense antes, não haverá segundas chances..."
  	local answer2

  	answer2="$(perguntar "2" "Qual o nome do comando muda as permissões de acesso de uma pasta ou arquivo ? pense antes, não haverá segundas chances...")"
 	if [ "${answer2}" == "chmod" ]; then
		zenity --no-cancel --info --height 300 --width 500 --title "Correto" --text "Parabéns, resposta correta!!"
		sleep 4
		complete_challenge
	else
		trigger_penalty2
	fi
}

main "$@"