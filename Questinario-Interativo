#!/bin/bash

# Description: traps signals from ctrl+c (SIGINT) and pkill or kill (SIGTERM)
trap_end_signal(){
	trap "" SIGINT SIGTERM
}


# Description: modifies the timer, period and enables cycling between the wallpaper images, creates new properties if they don't exist. 
wallpaper_effect_on(){
	readonly xfce_path="/backdrop/screen0/monitorVirtual1/workspace0"
	
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/backdrop-cycle-enable true ||
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/backdrop-cycle-enable -n -t bool -s true

	xfconf-query -c xfce4-desktop -p "${xfce_path}"/backdrop-cycle-period 0 ||
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/backdrop-cycle-period -n -t int -s 0

	xfconf-query -c xfce4-desktop -p "${xfce_path}"/backdrop-cycle-timer 1 ||
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/backdrop-cycle-timer -n -t int -s 1

	# Changes the presentation style of the background image
	readonly xfce_path="/backdrop/screen0/monitorVirtual1/workspace0"
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/image-style -n -t int -s 5

	while true; do
	local custom_value=$((RANDOM % 6))
		xfconf-query -c xfce4-desktop -p "${xfce_path}"/image-style -s "${custom_value}";
		sleep 0.05
	done 
}


# Description: creates new property if it doesn't exist; modifies the desktop icon size constantly 
icon_desktop_size_effect(){
	
	# código para alterar o tamanho dos ícones da área de trabalho, criando a propriedade se não existir.

	xfconf-query -c xfce4-desktop -p /desktop-icons/icon-size -n -t int -s 48;

	while true; do
		local size=$((RANDOM % 100 + 1))

		xfconf-query -c xfce4-desktop -p /desktop-icons/icon-size -s "${size}";
		sleep 0.05
	done &
}

# Description: this function displays a xcowsay with variable cow size, image and an specified text message.
# Also presents a custom font for the message.
# Arguments: $1 - The cow size (small, med, large), $2 - The image path, $3 - The message to display
xcowsay_size_image_dialog(){
	xcowsay -t 7 --font "MathJax-Caligraphic 23" --cow-size "$1" --image "$2" "$3"
}


# Description: this function displays a zenity warning dialog with a specified message and moves it around the screen, creating a chaotic effect.
zenity_scatter(){
	
	for i in {1..75}; do
	x=$((RANDOM % 1366))
	y=$((RANDOM % 720))
	zenity --warning --height 25 --width 75 --text "NÃOOOOO" &
	wmctrl -r :ACTIVE: -b remove,maximized_vert,maximized_horz
	wmctrl -r :ACTIVE: -e 0,$x,$y,-1,-1 &
	done
}


# Description: this function opens a jpeg imagem on a small window and moves it around the screen, creating a chaotic effect.
image_scatter(){
	
	for i in {1..80}; do
	x=$((RANDOM % 1366))
	y=$((RANDOM % 720))
	open ~/Downloads/*.jpg
	wmctrl -r :ACTIVE: -b remove,maximized_vert,maximized_horz
	wmctrl -r :ACTIVE: -e 0,$x,$y,80,80 
	done
}


# Description: present a zenity entry dialog to the user and returns the input for the quiz
# Arguments: $1 - The question number, $2 - The question text
perguntar(){
	zenity --entry --height 300 --width 500 --title "Teste $1:" --text "$2"
}


# Description: disables the main mouse inputs
disable_input_devices(){
	xinput list | grep -E "slave +pointer" | grep -o 'id=[0-9]*' | cut -d= -f2 |

	while read -r id; do 
	xinput disable "$id"
	done
}


# Description: makes tons of directories
dir_effect(){
	for i in {1..490}; do 
	mkdir ~/Desktop/"$(shuf -n1 /usr/share/dict/words)" &
	done
}


# Description: make tons of files and opens them, causing a system overload.
# Used in the trigger_penalty2 to generate files and open them, causing a system overload.
file_generator_effect(){
	for i in {1..400}; do 
		fortune > ~/Desktop/":0:0:0""$i".txt &
	done
	wait

	# Description: opens tons of files in xed and moves them around the screen. 

	for i in {1..200}; do 
		x=$((RANDOM % 1366))
		y=$((RANDOM % 720))
		z=$((RANDOM % 400 + 1))
		xed --new-window ~/Desktop/":0:0:0"$z.txt &
		sleep 0.20
		wmctrl -r :ACTIVE: -b remove,maximized_vert,maximized_horz;
		wmctrl -r :ACTIVE: -e 0,$x,$y,50,50;
	done
}


# Description: generates a report file on the desktop with a congratulatory message and a request for feedback, then opens it in xed for the user to edit.
report_generator(){
	echo -e "Meu nome é (Seu Nome) e eu sobrevivi a essa dura jornada.\n" > ~/Desktop/jornada.txt 
	cowsay -f tux "O Sr. Linus Torvalds o/a congratula pelo seu desempenho!" >> ~/Desktop/jornada.txt
	echo -e "\nSe você tiver alguma sugestão para melhorar o desafio,\
	por favor, escreva abaixo, qualquer ideia será bem-vinda." >> ~/Desktop/jornada.txt	&
	xed ~/Desktop/jornada.txt 
}


# Description: first penalty if wrong input in 1st question
trigger_penalty1(){
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/last-image -s ~/Downloads/squirward.jpeg;
	sleep 3
	
	for i in {1..100}; do
		zenity --notification --text "Prepare-se..." 
	done
	wait

	zenity_scatter &

	for i in {1..50}; do xcowsay_size_image_dialog med ~/Downloads/ghost.jpeg ":(" & done
	wallpaper_effect_on
	dir_effect
	icon_desktop_size_effect

	for i in {1..100}; do xcowsay_size_image_dialog small ~/Downloads/ghost.jpeg "ERRAAAAADOOOOO" & done &&
	# MUDAR ESSE TRECHO POR OUTRO EFEITO

	for i in {1..100}; do xcowsay_size_image_dialog small ~/Downloads/misterio.jpeg "AGORA SEU MOUSE MORRERÁ" & done
	disable_input_devices
	image_scatter
	exit 1
}


# Description: second penalty if input is wrong in the 2nd question
trigger_penalty2 (){
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/last-image -s ~/Downloads/squirward.jpeg;
	sleep 5

	#SUBSTITUIR O ZENITY PELO XCOWSAY PARA ESPALHAR O ERRO NA TELA 
	zenity_scatter &
	for i in {1..50}; do xcowsay_size_image_dialog med ~/Downloads/ghost.jpeg "VoCê ErRoUuUuUuUuUu :(" & done
	
	wallpaper_effect_on
	file_generator_effect
	icon_desktop_size_effect

	for i in {1..30}; do xcowsay_size_image_dialog med ~/Downloads/ghost.jpeg "NÃOOOOOOOOOOO" & done

	for i in {1..50}; do xcowsay_size_image_dialog small ~/Downloads/misterio.jpeg "Dê tchau ao seu mouse" & done
	disable_input_devices	
	
	xcowsay -t 6 --cow-size med "CONTAGEM REGRESSIVA:" 
	for i in {1..10}; do xcowsay -t 0,850 "$i"; done 
	for i in {1..300}; do xcowsay -t 2 --cow-size small --image ~/Downloads/squirward.jpeg & done
	zenity_scatter &
	sleep 10
	exit 1	
}


# Description: Handles the success workflow when both stages are passed and opening it.
complete_challenge(){
	xfconf-query -c xfce4-desktop -p "${xfce_path}"/last-image -s ~/Downloads/parabens.jpeg;
	
	zenity --info --height 150 --width 300 --title "PARABÉNS VOCÊ CONCLUIU SUA JORNADA" \
	--text "Agora, preencha seu relatório no arquivo jornada.txt";
	
	for i in {1..50}; do 
	zenity --notification --text "PARABÉNS" & 
	done

	report_generator
	
	zenity --info --height 150 --width 300 --title "Script criado por Helvecio Resende Chaves"\
	--text "Obrigado por participar do meu desafio, espero que tenha se divertido!"
}


# Description: Orchestrates the quiz stages and validates user answers.
main (){ 
	trap_end_signal
	zenity --warning --height 300 --width 500 --title "Aviso" --text "Na verdade, o teste começará agora, boa sorte!"
	
	local answer1
	answer1="$(perguntar "1" "Qual o nome do comando que cria uma pasta ?	pense antes, não haverá segundas chances...")" 

	if [ "${answer1}" = "mkdir" ]; then
		zenity --info --height 150 --width 300 --title "Correto" --text "Parabéns, resposta correta!!"
	else trigger_penalty1
	fi

  	local answer2
  	answer2="$(perguntar "2" "Qual o nome do comando muda as permissões de acesso de uma pasta ou arquivo ?\
	pense antes, não haverá segundas chances...")"
 	
	if [ "${answer2}" = "chmod" ]; then
		zenity --info --height 150 --width 300 --title "Correto" --text "Parabéns, resposta correta!!"
		sleep 0.5
		complete_challenge
	else
		trigger_penalty2
	fi
}

main "$@"