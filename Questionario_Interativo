		echo -e "\nEntão você gosta de mão na massa ?! Bom teste, ${name}!\n \
		\nAbrindo em 5 segundos:        \nPressione c para cancelar"

		for i in {1..5}; do 
			echo "$i..."
			sleep 1
		done
