	elif [[ "${option_selected}" == "3" ]]; then
		echo -e "\nInteressante ${name}! Gosteu da curiosidade, vamos conhecer algumas partes\
		desse script que estamos executando no momento.\n\
		\nAbrindo em 5 segundos:        \nPressione c para cancelar"

		for i in {1..5}; do 
			echo "$i..."
			sleep 1 
		done

		echo -e "\n\nO modo de conhecimento do algoritmo ainda não foi implementado, aguarde futuras atualizações do script."

	elif [[ "${option_selected}" == "4" ]]; then
		echo -e "\nFechando em 5 segundos:"		
		for i in {1..5}; do
			echo -e "$i..."; 
			sleep 1
		done
			return 0

	fi
}


# Description: present a zenity entry dialog to the user and returns the input for the quiz
# Arguments: $1 - The title, $2 - The question text
perguntar(){
	zenity --entry --height 300 --width 500 --title "$1" --text "$2"
}

