		"$HOME/Downloads/correto3.jpeg" 
		"$HOME/Downloads/correto4.jpeg" 
		"$HOME/Downloads/correto5.jpeg" 
		"$HOME/Downloads/correto6.jpeg" 
		"$HOME/Downloads/correto7.jpeg" 
		"$HOME/Downloads/correto8.jpeg" 
		"$HOME/Downloads/correto9.jpeg" 
		"$HOME/Downloads/correto10.jpeg" 
		)

		local x="$((RANDOM % 13))"

		xfconf-query -c xfce4-desktop -p "${XFCE_PATH}/last-image" -s "${used_images[x]}"

