#region #? MODE FUNCTIONS

# Description: was the previous main function, due to expasion of more modes, made into mode-1
mode_open_quiz(){
	trap_end_signal

	zenity --info --height 300 --width 500 --title "Aviso" --text "O teste começará agora, boa sorte!"
	
	# FIRST QUESTION

	local answer1
	answer1="$(perguntar "1ª pergunta" "Qual o nome do comando que cria uma pasta ?	pense antes, não haverá segundas chances...")" 

	if [ "${answer1}" = "mkdir" ]; then
		zenity --info --height 150 --width 300 --title "Correto" --text "Parabéns, resposta correta!!"
	else trigger_penalty1
	fi

	# SECOND QUESTION

  	local answer2
  	answer2="$(perguntar "2ª pergunta" "Qual o nome do comando muda as permissões de acesso de uma pasta ou arquivo ?\
	pense antes, não haverá segundas chances...")"
 	
	if [ "${answer2}" = "chmod" ]; then
		zenity --info --height 150 --width 300 --title "Correto" --text "Parabéns, resposta correta!!"
		right_answer_effect &

		sleep 1
		complete_challenge
	else
		trigger_penalty2
	fi

}

