	#sets the kind of display image pattern
	xfconf-query -c xfce4-desktop -p "${XFCE_PATH}"/image-style -s 2 &

	while true; do 
		
		local used_images=(
		"$HOME/Downloads/prateado.jpeg"
		"$HOME/Downloads/parabens.jpeg"
		"$HOME/Downloads/correto.jpeg" 
		"$HOME/Downloads/correto1.jpeg" 
